NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB URI (leave empty or use mongodb://localhost:27017/waterleak-watch. In-memory fallback will automatically kick in if local MongoDB is not running)
MONGODB_URI=mongodb://127.0.0.1:27017/waterleak-watch

# JWT Secrets
JWT_ACCESS_SECRET=wlw_super_secret_access_jwt_key_2026_production_grade
JWT_REFRESH_SECRET=wlw_super_secret_refresh_jwt_key_2026_production_grade
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Proximity Clustering Radius (meters)
CLUSTER_PROXIMITY_RADIUS_METERS=50

# Storage
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

